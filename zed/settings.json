// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "preview_tabs": {
    "enabled": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "use_system_window_tabs": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "reveal_if_open": false,
  "tab_bar": {
    "show": false
  },
  "tab_size": 2,
  "vim": {
    "use_system_clipboard": "on_yank",
    "toggle_relative_line_numbers": true,
    "picker_mode": "insert"
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "effort": "max",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna"
    },
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark"
  },
  "languages": {
    "Ruby": {
      // Use ruby-lsp as the primary language server and rubocop as the secondary.
      "language_servers": ["ruby-lsp", "rubocop", "!solargraph", "!steep", "!kanayago", "!sorbet"]
    }
  },
  "lsp": {
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false
      },
      "binary": {
        "path": "~/.rbenv/shims/bundle",
        "arguments": ["exec", "rubocop", "--lsp"]
      }
    },
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": false
        }
      },
      "binary": {
          "path": "~/.rbenv/shims/bundle",
          "arguments": ["exec", "ruby-lsp"]
      }
    }
  }
}
